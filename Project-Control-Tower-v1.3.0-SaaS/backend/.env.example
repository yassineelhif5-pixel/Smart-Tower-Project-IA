# Copier ce fichier en .env (jamais committé) et remplir les valeurs.
# Toutes ces variables sont lues côté serveur uniquement ; aucune n'est envoyée au navigateur.

# Clé secrète Django (longue chaîne aléatoire).
DJANGO_SECRET_KEY=
# true en développement local uniquement.
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origines autorisées à envoyer des formulaires (ex. https://pct.example.com).
DJANGO_CSRF_TRUSTED_ORIGINS=

# Base PostgreSQL. En développement : une base locale séparée.
# En production : la chaîne de connexion Supabase (Project Settings → Database), avec ?sslmode=require.
DATABASE_URL=postgresql://utilisateur:motdepasse@localhost:5432/pct_dev

# Clé de chiffrement des secrets saisis dans le module Configuration (clé Fernet).
# Rotation : nouvelle_clé,ancienne_clé puis `python manage.py rotate_secrets`, puis retirer l'ancienne.
# Générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# La remplacer sans garder l'ancienne derrière rend illisibles les secrets déjà enregistrés.
FIELD_ENCRYPTION_KEY=

# Durées de conservation des journaux, appliquées par `python manage.py purge_logs` (à planifier chaque jour).
# Journal des appels API : 90 jours par défaut. Journal d'audit : 365 jours par défaut (minimum 30).
API_LOG_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=365

# Licences concurrentes : une session inactive depuis ce délai (minutes) rend sa licence. Minimum 5.
LICENSE_SESSION_IDLE_MINUTES=30
# Adresse IP du journal d'audit : true uniquement derrière un reverse proxy de confiance qui écrit X-Forwarded-For.
TRUST_X_FORWARDED_FOR=false
