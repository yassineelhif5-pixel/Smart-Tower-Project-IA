# Copier ce fichier en .env (jamais committé) et remplir les valeurs.
# Toutes ces variables sont lues côté serveur uniquement ; aucune n'est envoyée au navigateur.

# Clé secrète Django (longue chaîne aléatoire).
DJANGO_SECRET_KEY=
# true en développement local uniquement.
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origines autorisées à envoyer des formulaires (ex. https://pct.example.com).
DJANGO_CSRF_TRUSTED_ORIGINS=

# Base PostgreSQL. En développement : une base locale séparée.
# En production : la chaîne de connexion Supabase (Project Settings → Database), avec ?sslmode=require.
DATABASE_URL=postgresql://utilisateur:motdepasse@localhost:5432/pct_dev

# Clé de chiffrement des secrets saisis dans le module Configuration (clé Fernet).
# Générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# La changer rend illisibles les secrets déjà enregistrés.
FIELD_ENCRYPTION_KEY=
